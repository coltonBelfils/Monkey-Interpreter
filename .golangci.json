{
  "formatters": {
    "exclusions": {
      "generated": "lax",
      "paths": [
        "third_party$",
        "builtin$",
        "examples$"
      ]
    }
  },
  "linters": {
    "enable": [
      "goconst",
      "gocritic",
      "nilnil",
      "tagalign"
    ],
    "exclusions": {
      "generated": "lax",
      "paths": [
        "third_party$",
        "builtin$",
        "examples$"
      ],
      "presets": [
        "comments",
        "common-false-positives",
        "legacy",
        "std-error-handling"
      ]
    },
    "settings": {
      "gocritic": {
        "disabled-checks": [
          "ifElseChain",
          "commentFormatting"
        ]
      },
      "staticcheck": {
        "checks": [
          "all",
          "-SA5008",
          "-ST1000",
          "-ST1003",
          "-ST1016",
          "-ST1020",
          "-ST1021",
          "-ST1022"
        ]
      },
      "tagalign": {
        "align": true,
        "order": [
          "json",
          "db",
          "dbtype",
          "yaml",
          "yml",
          "xml",
          "toml",
          "csv",
          "tsv",
          "mapstructure",
          "binding",
          "validate"
        ],
        "sort": true,
        "strict": true
      },
      "tagliatelle": {
        "case": {
          "rules": {
            "db": "lower",
            "dbtype": "lower"
          }
        }
      }
    }
  },
  "version": "2"
}
